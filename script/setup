#!/bin/sh
# setup — ensure Go toolchain and the `gorun` script runner are installed.
#
# Idempotent: safe to re-run. Designed as the bootstrap step before executing
# any other script in this folder (e.g. `script/hello`), which rely on `gorun`
# to compile-and-run single-file Go scripts via the polyglot shebang trick.
#
# Behavior:
#   1. If `go` is missing, install it. Prefers `mise` when the repo's
#      `mise.toml` is present (matches the repo's toolchain convention);
#      otherwise downloads the official tarball from go.dev into
#      ~/.local/go.
#   2. Installs `gorun` via `go install github.com/erning/gorun@latest` if
#      it is not already on PATH.
#   3. Warns when the Go bin dir is not on PATH so the user knows to add
#      it to their shell profile.
#
# Exit codes: 0 on success, 1 on any install failure or unsupported
# OS/arch (only linux/darwin × amd64/arm64 are supported for the tarball
# path).

set -eu

# err prints a message to stderr and exits 1.
err() { printf 'setup: %s\n' "$1" >&2; exit 1; }

# info prints a status line to stdout.
info() { printf 'setup: %s\n' "$1"; }

# Absolute path to the repo root (parent of script/).
REPO_ROOT=$(cd "$(dirname "$0")/.." && pwd)

# install_go_via_mise uses mise to install the Go version pinned in
# mise.toml. Activates mise for the current shell so subsequent `go`
# invocations resolve, and prepends mise's Go bin dir to PATH as a
# fallback when activation is not wired up.
install_go_via_mise() {
    info "installing go via mise..."
    (cd "$REPO_ROOT" && mise install go)
    eval "$(mise activate sh)" 2>/dev/null || true
    export PATH="$(mise where go 2>/dev/null)/bin:$PATH"
}

# install_go_via_tarball downloads the latest official Go release tarball
# and extracts it to ~/.local/go. Detects OS/arch via uname and refuses
# unsupported combinations. Removes any previous ~/.local/go before
# extracting to avoid mixing versions.
install_go_via_tarball() {
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch=$(uname -m)
    case "$arch" in
        x86_64|amd64) arch=amd64 ;;
        aarch64|arm64) arch=arm64 ;;
        *) err "unsupported arch: $arch" ;;
    esac
    case "$os" in
        linux|darwin) ;;
        *) err "unsupported OS: $os" ;;
    esac

    info "fetching latest Go version..."
    ver=$(curl -fsSL https://go.dev/VERSION?m=text | head -n1)
    [ -n "$ver" ] || err "could not resolve latest Go version"
    tarball="${ver}.${os}-${arch}.tar.gz"
    url="https://go.dev/dl/${tarball}"
    dest="$HOME/.local"
    mkdir -p "$dest"
    info "downloading $url..."
    tmp=$(mktemp -d)
    curl -fsSL "$url" -o "$tmp/go.tar.gz" || err "download failed"
    rm -rf "$dest/go"
    tar -C "$dest" -xzf "$tmp/go.tar.gz" || err "extract failed"
    rm -rf "$tmp"
    export PATH="$dest/go/bin:$PATH"
    info "installed Go to $dest/go. Add $dest/go/bin to PATH in your shell profile."
}

# --- 1. Ensure Go is installed ----------------------------------------------
if ! command -v go >/dev/null 2>&1; then
    info "go not found. Installing..."
    if command -v mise >/dev/null 2>&1 && [ -f "$REPO_ROOT/mise.toml" ]; then
        install_go_via_mise
    else
        install_go_via_tarball
    fi
    command -v go >/dev/null 2>&1 || err "go install failed."
fi
info "go: $(go version)"

# --- 2. Ensure gorun is installed -------------------------------------------
# Resolve the directory where `go install` drops binaries. GOBIN wins when
# set, otherwise GOPATH/bin. We check both PATH and the resolved BINDIR
# because gorun may exist on disk but not yet be reachable via PATH.
GOBIN=$(go env GOBIN)
GOPATH=$(go env GOPATH)
BINDIR=${GOBIN:-$GOPATH/bin}

# Warn (don't fail) when BINDIR is missing from PATH — the script can still
# install gorun, but the user needs to wire PATH up for normal use.
case ":$PATH:" in
    *":$BINDIR:"*) ;;
    *) info "warning: $BINDIR not on PATH. Add it to your shell profile." ;;
esac

if ! command -v gorun >/dev/null 2>&1 && [ ! -x "$BINDIR/gorun" ]; then
    info "installing gorun..."
    go install github.com/erning/gorun@latest
fi

# Report the resolved location. If gorun exists only on disk (not PATH),
# surface that explicitly so the user knows to fix PATH.
if command -v gorun >/dev/null 2>&1; then
    info "gorun: $(command -v gorun)"
elif [ -x "$BINDIR/gorun" ]; then
    info "gorun: $BINDIR/gorun (not on PATH)"
else
    err "gorun install failed."
fi

info "ok"
